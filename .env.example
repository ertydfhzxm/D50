# Landing-C V2.0 Environment Configuration
# Copy this file to .env and fill in the values below

# Server Port (Independent from IFS portal)
PORT=3005

# JWT Authentication Secret (Used for logins and game saves)
JWT_SECRET=your_super_secret_jwt_key_here

# Minimax API Key (For AI Companion, Narrative Moderation, and Game Events)
MINIMAX_API_KEY=your_minimax_api_key_here
